# Copy to .env and fill in. .env is gitignored and is read ONLY by the local
# service (server/index.mjs) - it is never bundled into the renderer.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PI_PORT=8787

# Only needed for identity-linked API keys (the API will tell you if it is).
# Find it in the Console URL when viewing your workspace.
ANTHROPIC_WORKSPACE_ID=
